<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kakao Walk ACCESSIBLE Guide Extractor</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #f6f7f9;
      --panel: #ffffff;
      --text: #1d1e20;
      --muted: #73777f;
      --line: #e5e7eb;
      --accent: #fee500;
      --accent-text: #191919;
      --danger: #d93025;
      --ok: #16794a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, "Noto Sans KR", sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    .wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 28px 18px 50px;
    }
    h1 {
      font-size: 24px;
      margin: 0 0 8px;
    }
    .desc {
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 20px;
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 16px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .full { grid-column: 1 / -1; }
    label {
      display: block;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    input {
      width: 100%;
      height: 44px;
      border: 1px solid #d8dbe0;
      border-radius: 10px;
      padding: 0 12px;
      font-size: 15px;
      outline: none;
    }
    input:focus { border-color: #999; }
    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }
    button {
      height: 42px;
      border: 0;
      border-radius: 10px;
      padding: 0 15px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }
    .primary {
      background: var(--accent);
      color: var(--accent-text);
    }
    .secondary {
      background: #eef0f3;
      color: var(--text);
    }
    .status {
      margin-top: 12px;
      min-height: 22px;
      font-size: 14px;
      line-height: 1.5;
      color: var(--muted);
      white-space: pre-wrap;
    }
    .status.error { color: var(--danger); }
    .status.ok { color: var(--ok); }
    .urlbox {
      margin-top: 12px;
      padding: 10px 12px;
      background: #f7f8fa;
      border: 1px solid var(--line);
      border-radius: 10px;
      font-family: Consolas, monospace;
      font-size: 12px;
      word-break: break-all;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    th, td {
      padding: 11px 10px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }
    th {
      background: #fafafa;
      position: sticky;
      top: 0;
    }
    td.num, th.num { text-align: right; white-space: nowrap; }
    .table-wrap {
      overflow: auto;
      max-height: 540px;
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .coords {
      margin-top: 14px;
      padding: 14px;
      background: #111;
      color: #fff;
      border-radius: 12px;
      font-family: Consolas, monospace;
      font-size: 13px;
      line-height: 1.65;
      white-space: pre-wrap;
    }
    .note {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.6;
      margin-top: 12px;
    }
    @media (max-width: 680px) {
      .grid { grid-template-columns: 1fr; }
      .full { grid-column: auto; }
      th, td { padding: 9px 8px; font-size: 12px; }
    }
  </style>
</head>
<body>
<div class="wrap">
  <h1>Kakao 도보 ACCESSIBLE 좌표 추출기</h1>
  <div class="desc">
    출발점 A와 도착점 B의 위도·경도를 입력하면 카카오 도보 길찾기 URL을 만들고,
    공식 도보 Routing API의 <b>ACCESSIBLE</b> 경로에서 안내 단계별 위도·경도를 추출합니다.
  </div>

  <div class="panel">
    <div class="grid">
      <div class="full">
        <label for="restKey">Kakao REST API Key</label>
        <input id="restKey" type="password" value="1a369cc516286a1ffcfa9285ecc48812" placeholder="REST API 키 입력" autocomplete="off" />
      </div>

      <div>
        <label for="aLat">A 위도</label>
        <input id="aLat" value="37.5653577" inputmode="decimal" />
      </div>
      <div>
        <label for="aLng">A 경도</label>
        <input id="aLng" value="126.9788018" inputmode="decimal" />
      </div>

      <div>
        <label for="bLat">B 위도</label>
        <input id="bLat" value="37.5654545" inputmode="decimal" />
      </div>
      <div>
        <label for="bLng">B 경도</label>
        <input id="bLng" value="126.9796159" inputmode="decimal" />
      </div>
    </div>

    <div class="buttons">
      <button class="primary" id="runBtn">ACCESSIBLE 경로 조회</button>
      <button class="secondary" id="openBtn">카카오맵 URL 열기</button>
      <button class="secondary" id="copyBtn">좌표 복사</button>
    </div>

    <div class="urlbox" id="mapUrl"></div>
    <div class="status" id="status"></div>

    <div class="note">
      ※ 카카오 공식 Routing API는 입력 X=경도, Y=위도입니다.<br>
      ※ 이 페이지는 <code>route_mode=ACCESSIBLE</code>, <code>input_coord=WGS84</code>,
      <code>output_coord=WGS84</code>로 요청합니다.<br>
      ※ 브라우저에서 REST API 키를 직접 사용하는 방식은 테스트/개발용에 적합합니다.
      운영 서비스에서는 서버 프록시에서 REST API 키를 보관하는 방식을 권장합니다.
    </div>
  </div>

  <div class="panel">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="num">seq</th>
            <th>guideMent / guidance</th>
            <th class="num">위도</th>
            <th class="num">경도</th>
            <th class="num">거리(m)</th>
          </tr>
        </thead>
        <tbody id="rows">
          <tr><td colspan="5" style="text-align:center;color:#888;padding:30px;">조회 결과가 여기에 표시됩니다.</td></tr>
        </tbody>
      </table>
    </div>

    <div class="coords" id="coordText">좌표 목록</div>
  </div>
</div>

<script>
(() => {
  const $ = id => document.getElementById(id);

  const restKey = $('restKey');
  const aLat = $('aLat');
  const aLng = $('aLng');
  const bLat = $('bLat');
  const bLng = $('bLng');
  const mapUrlBox = $('mapUrl');
  const status = $('status');
  const rows = $('rows');
  const coordText = $('coordText');

  function valNumber(el, label) {
    const n = Number(el.value.trim());
    if (!Number.isFinite(n)) throw new Error(label + ' 값이 올바르지 않습니다.');
    return n;
  }

  function getPoints() {
    const A = {
      lat: valNumber(aLat, 'A 위도'),
      lng: valNumber(aLng, 'A 경도')
    };
    const B = {
      lat: valNumber(bLat, 'B 위도'),
      lng: valNumber(bLng, 'B 경도')
    };
    return { A, B };
  }

  function buildMapUrl() {
    const { A, B } = getPoints();
    return `https://map.kakao.com/link/by/walk/A,${A.lat},${A.lng}/B,${B.lat},${B.lng}`;
  }

  function refreshUrl() {
    try {
      mapUrlBox.textContent = buildMapUrl();
    } catch {
      mapUrlBox.textContent = '';
    }
  }

  function setStatus(msg, type='') {
    status.className = 'status' + (type ? ' ' + type : '');
    status.textContent = msg;
  }

  function escapeHtml(s) {
    return String(s ?? '')
      .replaceAll('&','&amp;')
      .replaceAll('<','&lt;')
      .replaceAll('>','&gt;')
      .replaceAll('"','&quot;')
      .replaceAll("'","&#039;");
  }

  function flattenSteps(data) {
    const list = [];
    const legs = data?.route?.legs || [];

    for (const leg of legs) {
      const steps = leg?.steps || [];
      for (const step of steps) {
        const p = step?.properties || {};
        if (!Number.isFinite(Number(p.x)) || !Number.isFinite(Number(p.y))) continue;

        list.push({
          seq: list.length + 1,
          guideMent: p.guidance ?? '',
          x: Number(p.x), // WGS84 경도
          y: Number(p.y), // WGS84 위도
          distance: p.distance ?? ''
        });
      }
    }
    return list;
  }

  function render(list) {
    if (!list.length) {
      rows.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:30px;">안내 좌표를 찾지 못했습니다.</td></tr>';
      coordText.textContent = '좌표 목록 없음';
      return;
    }

    rows.innerHTML = list.map(item => `
      <tr>
        <td class="num">${item.seq}</td>
        <td>${escapeHtml(item.guideMent)}</td>
        <td class="num">${item.y.toFixed(7)}</td>
        <td class="num">${item.x.toFixed(7)}</td>
        <td class="num">${escapeHtml(item.distance)}</td>
      </tr>
    `).join('');

    coordText.textContent = list
      .map(item => `${item.seq}. ${item.y.toFixed(7)}, ${item.x.toFixed(7)}${item.guideMent ? '  |  ' + item.guideMent : ''}`)
      .join('\n');
  }

  async function run() {
    setStatus('');
    refreshUrl();

    const key = restKey.value.trim();
    if (!key) {
      setStatus('Kakao REST API Key를 입력하세요.', 'error');
      return;
    }

    let A, B;
    try {
      ({ A, B } = getPoints());
    } catch (e) {
      setStatus(e.message, 'error');
      return;
    }

    const params = new URLSearchParams({
      start_x: String(A.lng),
      start_y: String(A.lat),
      end_x: String(B.lng),
      end_y: String(B.lat),
      s_name: 'A',
      e_name: 'B',
      input_coord: 'WGS84',
      output_coord: 'WGS84',
      route_mode: 'ACCESSIBLE'
    });

    const apiUrl = 'https://dapi.kakao.com/v2/routing/walk?' + params.toString();

    setStatus('ACCESSIBLE 경로를 조회 중입니다...');

    try {
      const res = await fetch(apiUrl, {
        method: 'GET',
        headers: {
          'Authorization': 'KakaoAK ' + key
        }
      });

      const text = await res.text();
      let data;
      try {
        data = JSON.parse(text);
      } catch {
        throw new Error('카카오 API 응답을 JSON으로 읽지 못했습니다. HTTP ' + res.status);
      }

      if (!res.ok) {
        const msg = data?.msg || data?.message || JSON.stringify(data);
        throw new Error(`HTTP ${res.status}: ${msg}`);
      }

      if (data.status !== 'OK') {
        throw new Error('경로 조회 실패: ' + (data.status || 'UNKNOWN'));
      }

      const list = flattenSteps(data);
      render(list);

      const totalDistance = data?.route?.properties?.totalDistance;
      const totalTime = data?.route?.properties?.totalTime;
      setStatus(
        `완료: ACCESSIBLE 경로에서 ${list.length}개의 안내 좌표를 추출했습니다.` +
        (totalDistance != null ? `\n총 거리: ${totalDistance}m` : '') +
        (totalTime != null ? ` / 예상 시간: ${totalTime}초` : ''),
        'ok'
      );
    } catch (e) {
      console.error(e);
      setStatus(
        e.message +
        '\n\n브라우저의 CORS 정책으로 차단되는 환경이라면 이 HTML을 서버에서 실행하거나 REST API 요청을 서버 프록시로 옮겨야 합니다.',
        'error'
      );
    }
  }

  $('runBtn').addEventListener('click', run);

  $('openBtn').addEventListener('click', () => {
    try {
      window.open(buildMapUrl(), '_blank', 'noopener');
    } catch (e) {
      setStatus(e.message, 'error');
    }
  });

  $('copyBtn').addEventListener('click', async () => {
    const text = coordText.textContent;
    if (!text || text === '좌표 목록' || text === '좌표 목록 없음') {
      setStatus('복사할 좌표가 없습니다.', 'error');
      return;
    }
    try {
      await navigator.clipboard.writeText(text);
      setStatus('좌표 목록을 클립보드에 복사했습니다.', 'ok');
    } catch {
      setStatus('클립보드 복사에 실패했습니다.', 'error');
    }
  });

  [aLat, aLng, bLat, bLng].forEach(el => el.addEventListener('input', refreshUrl));
  refreshUrl();
})();
</script>
</body>
</html>
